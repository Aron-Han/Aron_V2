<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Evaluation-time includes also serve VS design-time compilation. The
       existing import survives a stale VS project save. Exclude prevents
       duplicates when the project already lists the source files explicitly. -->
  <ItemGroup>
    <Compile Include="Diagnostics\ProjectBackupService.cs" Exclude="@(Compile)" Condition="Exists('$(MSBuildProjectDirectory)\Diagnostics\ProjectBackupService.cs')" />
    <Compile Include="SaveImage\ImageStoragePolicy.cs" Exclude="@(Compile)" Condition="Exists('$(MSBuildProjectDirectory)\SaveImage\ImageStoragePolicy.cs')" />
    <Compile Include="Form\ImageRecord.Storage.cs" Exclude="@(Compile)" Condition="Exists('$(MSBuildProjectDirectory)\Form\ImageRecord.Storage.cs')" />
    <Compile Include="Form\FormMain.CameraRecovery.cs" Exclude="@(Compile)" Condition="Exists('$(MSBuildProjectDirectory)\Form\FormMain.CameraRecovery.cs')" />
    <Compile Include="Form\FormMain.Acquisition.cs" Exclude="@(Compile)" Condition="Exists('$(MSBuildProjectDirectory)\Form\FormMain.Acquisition.cs')" />
    <EmbeddedResource Include="$(VisionProSdkRoot)\bin\Templates\Tools\3D Tools\Cog3DRangeGreySplitterScript.vtt" Exclude="@(EmbeddedResource)" Condition="Exists('$(VisionProSdkRoot)\bin\Templates\Tools\3D Tools\Cog3DRangeGreySplitterScript.vtt')">
      <LogicalName>Aron.RangeGreySplitter.vtt</LogicalName>
    </EmbeddedResource>
    <Compile Include="Form\ImageRecord.Backup.cs" Exclude="@(Compile)" Condition="Exists('$(MSBuildProjectDirectory)\Form\ImageRecord.Backup.cs')">
      <DependentUpon>ImageRecord.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- SQLite's package normally copies both architectures. This application
       targets x64; retain its x64 native loader and omit only x86. -->
  <Target Name="SelectRuntimeSqliteArchitecture" BeforeTargets="CopySQLiteInteropFiles" Condition="'$(PlatformTarget)' == 'x64'">
    <ItemGroup>
      <SQLiteInteropFiles Remove="@(SQLiteInteropFiles)" Condition="'%(SQLiteInteropFiles.RecursiveDir)' == 'x86\'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveRuntimeApiDocumentation" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RuntimeApiDocumentation Include="$(TargetDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(RuntimeApiDocumentation)" Condition="Exists('$(TargetDir)%(RuntimeApiDocumentation.Filename).dll')" />
  </Target>
</Project>
